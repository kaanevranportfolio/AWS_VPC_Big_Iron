          "attributes": {
            "content": "all:\r\n  vars:\r\n    ansible_python_interpreter: /usr/bin/python3\r\n\r\n  children:\r\n    bastion:\r\n      hosts:\r\n        bastion:\r\n          ansible_host: 10.0.1.92\r\n          ansible_user: ubuntu\r\n          ansible_ssh_private_key_file: ./keys/bastion_key\r\n\r\n    nginx:\r\n      hosts:\r\n        nginx:\r\n          ansible_host: 3.101.58.109\r\n          ansible_user: ubuntu\r\n          ansible_ssh_private_key_file: ./keys/nginx_key\r\n\r\n    webservers:\r\n      hosts:\r\n        webserver:\r\n          ansible_host: 10.0.2.181\r\n          ansible_user: ec2-user\r\n          ansible_ssh_private_key_file: ./keys/web_server_key\r\n          ansible_ssh_common_args: '-o ProxyCommand=\"ssh -W %h:%p -q ubuntu@10.0.1.92 -o StrictHostKeyChecking=no -i ./keys/bastion_key\"'\r\n",
