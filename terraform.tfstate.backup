            "rendered": "nginx_public_ip: \"3.101.58.109\"\r\nbastion_private_ip: \"10.0.1.92\"\r\nwebserver_private_ip: \"10.0.2.181\"\r\ncontrol_server_private_ip: \"10.0.1.231\"\r\ncontrol_server_public_ip: \"13.56.59.138\"\r\n",
            "template": "nginx_public_ip: \"${nginx_public_ip}\"\r\nbastion_private_ip: \"${bastion_private_ip}\"\r\nwebserver_private_ip: \"${webserver_private_ip}\"\r\ncontrol_server_private_ip: \"${control_server_private_ip}\"\r\ncontrol_server_public_ip: \"${control_server_public_ip}\"\r\n",
            "vars": {
              "bastion_private_ip": "10.0.1.92",
              "control_server_private_ip": "10.0.1.231",
              "control_server_public_ip": "13.56.59.138",
