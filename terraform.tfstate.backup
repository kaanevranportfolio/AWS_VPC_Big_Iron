    {
      "mode": "data",
      "type": "template_file",
      "name": "inventory_ini",
      "provider": "provider[\"registry.terraform.io/hashicorp/template\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "filename": null,
            "id": "1c92419da0b7273b0a6ec7f46c57f0271036844ffd8f10dc1f809e83aa052b94",
            "rendered": "all:\r\n  vars:\r\n    ansible_python_interpreter: /usr/bin/python3\r\n\r\n  children:\r\n    bastion:\r\n      hosts:\r\n        bastion:\r\n          ansible_host: 10.0.1.92\r\n          ansible_user: ubuntu\r\n          ansible_ssh_private_key_file: ./keys/bastion_key\r\n\r\n    nginx:\r\n      hosts:\r\n        nginx:\r\n          ansible_host: 3.101.58.109\r\n          ansible_user: ubuntu\r\n          ansible_ssh_private_key_file: ./keys/nginx_key\r\n\r\n    webservers:\r\n      hosts:\r\n        webserver:\r\n          ansible_host: 10.0.2.181\r\n          ansible_user: ec2-user\r\n          ansible_ssh_private_key_file: ./keys/web_server_key\r\n          ansible_ssh_common_args: '-o ProxyCommand=\"ssh -W %h:%p -q ubuntu@10.0.1.92 -o StrictHostKeyChecking=no -i ./keys/bastion_key\"'\r\n",
            "template": "all:\r\n  vars:\r\n    ansible_python_interpreter: /usr/bin/python3\r\n\r\n  children:\r\n    bastion:\r\n      hosts:\r\n        bastion:\r\n          ansible_host: ${bastion_private_ip}\r\n          ansible_user: ubuntu\r\n          ansible_ssh_private_key_file: ./keys/bastion_key\r\n\r\n    nginx:\r\n      hosts:\r\n        nginx:\r\n          ansible_host: ${nginx_public_ip}\r\n          ansible_user: ubuntu\r\n          ansible_ssh_private_key_file: ./keys/nginx_key\r\n\r\n    webservers:\r\n      hosts:\r\n        webserver:\r\n          ansible_host: ${webserver_private_ip}\r\n          ansible_user: ec2-user\r\n          ansible_ssh_private_key_file: ./keys/web_server_key\r\n          ansible_ssh_common_args: '-o ProxyCommand=\"ssh -W %h:%p -q ubuntu@${bastion_private_ip} -o StrictHostKeyChecking=no -i ./keys/bastion_key\"'\r\n",
            "vars": {
              "bastion_private_ip": "10.0.1.92",
              "control_server_private_ip": "10.0.1.231",
              "nginx_public_ip": "3.101.58.109",
              "webserver_private_ip": "10.0.2.181"
            }
          },
          "sensitive_attributes": []
        }
      ]
    },
